# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (MongoDB Atlas, same cluster as the current site) ---
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/jbbc?retryWrites=true&w=majority"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin of the site. Used for absolute URLs in metadata, sitemap and emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="JBBC <noreply@jbbc.co.jp>"
EMAIL_INQUIRY_TO="info@jbbc.co.jp"

# --- Google Sheets (service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Keep the literal \n sequences; the app converts them to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_SHEET_ID_INQUIRY=""
GOOGLE_SHEET_ID_SEMINAR=""
GOOGLE_SHEET_ID_DOWNLOAD=""

# --- DigitalOcean Spaces (image uploads) ---
SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
SPACES_REGION="sgp1"
SPACES_BUCKET="bbc-images"
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_KEY=""
NEXT_PUBLIC_CDN_URL="https://bbc-images.sgp1.cdn.digitaloceanspaces.com"

# --- Cloudflare Turnstile (optional; forms work without it) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Google Analytics 4 (optional; off until set) ---
NEXT_PUBLIC_GA_ID=""
